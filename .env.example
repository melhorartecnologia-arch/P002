# ===========================================
# DORA - Diários Oficiais: Rastreamento e Análise
# Environment Configuration
# ===========================================

# Node
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://dora:dora_secret@localhost:5432/dora?schema=public
POSTGRES_USER=dora
POSTGRES_PASSWORD=dora_secret
POSTGRES_DB=dora

# Redis
REDIS_URL=redis://localhost:6379

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# MinIO (S3-compatible)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=dora_minio
MINIO_SECRET_KEY=dora_minio_secret
MINIO_BUCKET=dora-documents
MINIO_USE_SSL=false

# Qdrant
QDRANT_URL=http://localhost:6333

# Claude API (Anthropic)
ANTHROPIC_API_KEY=sk-ant-xxxxx
CLAUDE_MODEL_VISION=claude-sonnet-4-20250514
CLAUDE_MODEL_EXTRACTION=claude-sonnet-4-20250514
CLAUDE_MODEL_CLASSIFICATION=claude-haiku-4-5-20251001
CLAUDE_MODEL_ANALYSIS=claude-opus-4-6
CLAUDE_MAX_CONCURRENT_REQUESTS=50
CLAUDE_BATCH_ENABLED=true

# Voyage AI (Embeddings)
VOYAGE_API_KEY=voyage-xxxxx

# API Server
API_PORT=3001
API_HOST=0.0.0.0

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-change-in-production

# Email (Nodemailer)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@dora.local

# Scraping
SCRAPER_CONCURRENT_BROWSERS=3
SCRAPER_REQUEST_DELAY_MS=2000
SCRAPER_PROXY_POOL=

# Logging
LOG_LEVEL=info
